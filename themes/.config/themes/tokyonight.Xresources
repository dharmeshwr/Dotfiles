dwm.selbordercolor:       #7aa2f7
dwm.tagsnormfgcolor:      #a9b1d6
dwm.tagsnormbgcolor:      #1a1b26
dwm.tagsnormbordercolor:  #1a1b26
dwm.tagsselfgcolor:       #7aa2f7
dwm.tagsselbgcolor:       #24283b
dwm.tagsselbordercolor:   #24283b

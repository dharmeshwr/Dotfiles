! Font settings
Xft.dpi: 160
Xft.antialias: true
Xft.hinting: true
Xft.hintstyle: hintslight
Xft.rgba: rgb
Xft.lcdfilter: lcddefault

! Cursor settings
Xcursor.theme: MacOS-Tahoe-Cursor
Xcursor.size: 32

! Font
*.font: MartianMono Nerd Font-10
dmenu.font: MartianMono Nerd Font-10 
st.font: MartianMono Nerd Font-10 

! Clear existing modifiers
clear lock
clear control
clear mod1
clear mod4

! 1. Caps Lock (66) -> Control | Left Control (37) -> Escape
keycode 66 = Control_L
keycode 37 = Escape

! 2. Left Option (64) -> Super (Win) | Left Command (133) -> Alt
keycode 64 = Super_L
keycode 133 = Alt_L

! 3. Right Command (134) -> Alt | Right Option (108) -> Control
keycode 134 = Alt_R
keycode 108 = Control_R

! Re-assign modifiers
add lock = Caps_Lock
add control = Control_L Control_R
add mod1 = Alt_L Alt_R
add mod4 = Super_L Super_R
